{
  "name": "long-function-detect-lite",
  "displayName": "LongFunctionDetect_Lite",
  "description": "Поиск функций C++ длиннее 40 строк",
  "version": "0.0.1",
  "publisher": "student",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "LongFunctionDetect_Lite.check",
        "title": "LongFunctionDetect_Lite: проверить функции"
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
